{
  "ci": {
    "collect": {
      "startServerCommand": "npm run preview -- --port 4173 --host 127.0.0.1",
      "startServerReadyPattern": "4173",
      "startServerReadyTimeout": 30000,
      "numberOfRuns": 3,
      "url": [
        "http://127.0.0.1:4173/",
        "http://127.0.0.1:4173/shop",
        "http://127.0.0.1:4173/products/oak-side-table",
        "http://127.0.0.1:4173/account/register"
      ],
      "settings": {
        "preset": "mobile"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.95 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
        "total-blocking-time": ["error", { "maxNumericValue": 200 }],
        "render-blocking-resources": ["warn", { "maxLength": 1 }],
        "modern-image-formats": ["error", { "minScore": 0.9 }],
        "uses-responsive-images": ["error", { "minScore": 0.9 }],
        "resource-summary:script:size": ["error", { "maxNumericValue": 174080 }],
        "resource-summary:stylesheet:size": ["error", { "maxNumericValue": 51200 }],
        "resource-summary:image:size": ["error", { "maxNumericValue": 307200 }],
        "resource-summary:font:size": ["error", { "maxNumericValue": 102400 }]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
